QQ_APP_ID=
QQ_APP_SECRET=

# 礼包性价比网站地址，例如 https://gift.example.com（不要带末尾 /）
GIFT_API_BASE_URL=
GIFT_REQUEST_TIMEOUT=15

# 默认值已对齐当前 QQ 官方文档，通常无需修改。
# QQ_API_BASE=https://api.bot.qq.com
# QQ_TOKEN_URL=https://api.bot.qq.com/app/getAppAccessToken
# LOG_LEVEL=INFO

# 🖍️ 嘟嘟脸蜡笔板：默认通过礼包网站的 HTTPS Bot API 工作。
TRICKCAL_MODE=remote
TRICKCAL_API_BASE_URL=
TRICKCAL_BOT_API_KEY=

# LEGACY ONLY：仅 TRICKCAL_MODE=local 时使用；远程模式不会启动本地 Web/SQLite。
# TRICKCAL_WEB_PUBLIC_URL=https://你的域名/tr-board/
# TRICKCAL_WEB_SECURE_COOKIE=true
TRICKCAL_WEB_SESSION_DAYS=30
TRICKCAL_LOGIN_TICKET_MINUTES=10
